{
  "extends": "$app/tsconfig",
  "include": [
    "src",
    "test",
    "*"
  ],
  "exclude": [
    "src/service-worker"
  ],
  "compilerOptions": {
    "paths": {
      "#lib/*": [
        "./src/lib/*"
      ]
    },
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
