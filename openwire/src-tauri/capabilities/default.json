{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-content-protected",
    "opener:default",
    "rootcell:default",
    "core:path:default",
    {
      "identifier": "store:allow-get-store",
      "allow": [
        {
          "path": ".settings.dat"
        }
      ]
    },
    {
      "identifier": "store:allow-load",
      "allow": [
        {
          "path": ".settings.dat"
        }
      ]
    },
    {
      "identifier": "store:allow-get",
      "allow": [
        {
          "path": ".settings.dat"
        }
      ]
    },
    {
      "identifier": "store:allow-set",
      "allow": [
        {
          "path": ".settings.dat"
        }
      ]
    },
    {
      "identifier": "store:allow-save",
      "allow": [
        {
          "path": ".settings.dat"
        }
      ]
    },
    "dialog:default"
  ]
}