{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "store:default",
    {
      "identifier": "store:allow-load",
      "allow": [
        {
          "path": ".settings"
        }
      ]
    },
    {
      "identifier": "store:allow-get",
      "allow": [
        {
          "path": ".settings"
        }
      ]
    },
    {
      "identifier": "store:allow-set",
      "allow": [
        {
          "path": ".settings"
        }
      ]
    },
    {
      "identifier": "store:allow-save",
      "allow": [
        {
          "path": ".settings"
        }
      ]
    },
    "dialog:default"
  ]
}